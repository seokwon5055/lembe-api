<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.lembe.goal.mapper.GoalMapper">

    <resultMap id="GoalResultMap" type="com.lembe.goal.domain.Goal">
        <id     property="goalSeq"              column="goal_seq"/>
        <result property="userSeq"              column="user_seq"/>
        <result property="mode"                 column="mode"/>
        <result property="status"               column="status"/>
        <result property="startWeight"          column="start_weight"/>
        <result property="targetWeight"         column="target_weight"/>
        <result property="startBodyFatPct"      column="start_body_fat_pct"/>
        <result property="targetBodyFatPct"     column="target_body_fat_pct"/>
        <result property="startMuscleMassKg"    column="start_muscle_mass_kg"/>
        <result property="targetMuscleMassKg"   column="target_muscle_mass_kg"/>
        <result property="aiRegenCost"          column="ai_regen_cost"/>
        <result property="createdAt"            column="created_at"/>
        <result property="updatedAt"            column="updated_at"/>
    </resultMap>

    <select id="findActiveByUserSeq" resultMap="GoalResultMap">
        SELECT *
        FROM tb_goal
        WHERE user_seq = #{userSeq}
          AND status   = 'ACTIVE'
        ORDER BY created_at DESC
        LIMIT 1
    </select>

    <select id="findById" resultMap="GoalResultMap">
        SELECT *
        FROM tb_goal
        WHERE goal_seq = #{goalSeq}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="goalSeq">
        INSERT INTO tb_goal
            (user_seq, mode, status, start_weight, target_weight,
             start_body_fat_pct, target_body_fat_pct,
             start_muscle_mass_kg, target_muscle_mass_kg,
             ai_regen_cost)
        VALUES
            (#{userSeq}, #{mode}, 'ACTIVE', #{startWeight}, #{targetWeight},
             #{startBodyFatPct}, #{targetBodyFatPct},
             #{startMuscleMassKg}, #{targetMuscleMassKg},
             30)
    </insert>

    <update id="updateStatus">
        UPDATE tb_goal
        SET status = #{status}
        WHERE goal_seq = #{goalSeq}
    </update>

    <update id="updateTarget">
        UPDATE tb_goal
        SET target_weight          = #{targetWeight},
            target_body_fat_pct    = #{targetBodyFatPct},
            target_muscle_mass_kg  = #{targetMuscleMassKg}
        WHERE goal_seq = #{goalSeq}
    </update>

</mapper>
