<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.lembe.user.mapper.PointWalletMapper">

    <resultMap id="PointWalletResultMap" type="com.lembe.user.domain.PointWallet">
        <id     property="walletSeq" column="wallet_seq"/>
        <result property="ucode"   column="ucode"/>
        <result property="balance"   column="balance"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="walletSeq">
        INSERT INTO point_wallet (ucode, balance)
        VALUES (#{ucode}, #{balance})
    </insert>

    <select id="findByUcode" resultMap="PointWalletResultMap">
        SELECT *
        FROM point_wallet
        WHERE ucode = #{ucode}
    </select>

    <select id="findByUcodeForUpdate" resultMap="PointWalletResultMap">
        SELECT *
        FROM point_wallet
        WHERE ucode = #{ucode}
        FOR UPDATE
    </select>

    <!-- 잔액 차감 시 음수 방지: delta < 0이면 balance >= |delta| 조건 확인 -->
    <update id="updateBalance">
        UPDATE point_wallet
        SET balance = balance + #{delta}
        WHERE ucode = #{ucode}
        <if test="delta &lt; 0">
          AND balance >= #{delta} * -1
        </if>
    </update>

    <!-- 환불 전용: 잔액 부족해도 마이너스 허용 -->
    <update id="updateBalanceForRefund">
        UPDATE point_wallet
        SET balance = balance + #{delta}
        WHERE ucode = #{ucode}
    </update>

</mapper>
