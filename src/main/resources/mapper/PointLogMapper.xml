<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.lembe.point.mapper.PointLogMapper">

    <resultMap id="PointLogResultMap" type="com.lembe.point.domain.PointLog">
        <id     property="pointLogSeq"  column="point_log_seq"/>
        <result property="ucode"      column="ucode"/>
        <result property="delta"        column="delta"/>
        <result property="balanceAfter" column="balance_after"/>
        <result property="reason"       column="reason"/>
        <result property="refId"        column="ref_id"/>
        <result property="createdAt"    column="created_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="pointLogSeq">
        INSERT INTO point_log
            (ucode, delta, balance_after, reason, ref_id)
        VALUES
            (#{ucode}, #{delta}, #{balanceAfter}, #{reason}, #{refId})
    </insert>

    <select id="findHistory" resultMap="PointLogResultMap">
        SELECT *
        FROM point_log
        WHERE ucode = #{ucode}
        ORDER BY created_at DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countByUserSeq" resultType="int">
        SELECT COUNT(*) FROM point_log WHERE ucode = #{ucode}
    </select>

</mapper>
