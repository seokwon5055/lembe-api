<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.lembe.user.mapper.UserProfileMapper">

    <resultMap id="UserProfileResultMap" type="com.lembe.user.domain.UserProfile">
        <id     property="profileSeq"           column="profile_seq"/>
        <result property="ucode"              column="ucode"/>
        <result property="gender"               column="gender"/>
        <result property="birthYear"            column="birth_year"/>
        <result property="heightCm"             column="height_cm"/>
        <result property="notificationEnabled"  column="notification_enabled"/>
        <result property="createdAt"            column="created_at"/>
        <result property="updatedAt"            column="updated_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="profileSeq">
        INSERT INTO user_profile (ucode, gender, birth_year, height_cm, notification_enabled)
        VALUES (#{ucode}, #{gender}, #{birthYear}, #{heightCm}, #{notificationEnabled})
    </insert>

    <select id="findByUserSeq" resultMap="UserProfileResultMap">
        SELECT *
        FROM user_profile
        WHERE ucode = #{ucode}
    </select>

</mapper>
